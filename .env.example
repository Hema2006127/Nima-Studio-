# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the site, used in verification / password-reset email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The service-role key is NOT needed by this app — every query runs as the
# signed-in user under RLS. Never add it with a NEXT_PUBLIC_ prefix.
